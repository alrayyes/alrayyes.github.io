# What this site builds, not what an editor or OS drops beside it —
# those live in ~/.config/git/gitignore_global, not here.

node_modules/
.bun-cache/

# Astro's build output and its own generated types.
dist/
.astro/

# bun test --coverage's lcov report, uploaded to Codecov by CI.
coverage/

# bun test's JUnit report, uploaded to Codecov by CI.
junit/

# The reports CI assembles for the deploy, see scripts/assemble-reports.ts.
site-reports/

# Playwright's own run output.
test-results/
playwright-report/

# Claude Code's per-session local permission overrides.
.claude/settings.local.json

# Never committed, per-environment.
.env
.env.production

# Written by the release job, not by hand.
CHANGELOG.md

# Vale's style packages, downloaded by `vale sync`.
/styles/Google/
/styles/proselint/
