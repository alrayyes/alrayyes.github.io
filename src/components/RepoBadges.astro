---
import type { Badge } from "../data/apis";

interface Props {
  name: string;
  badges: Badge[];
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const { name, badges } = Astro.props;
---

{/* The README's own badge images, at their native 20px height. Each link is
min-h-6 (24px), WCAG 2.5.8's minimum, with the image centred in it. The images
keep their own colours in both themes. */}
{badges.length > 0 && (
  <ul
    aria-label={`Badges for ${name}`}
    class="mt-1 flex flex-wrap gap-x-1.5 gap-y-0.5"
  >
    {badges.map((badge) => (
      <li>
        <a
          href={badge.href}
          class="inline-flex min-h-6 items-center rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-accent dark:focus-visible:ring-accent-dark"
        >
          <img
            src={badge.image}
            alt={badge.label}
            height="20"
            loading="lazy"
            decoding="async"
            class="h-5 w-auto"
          />
        </a>
      </li>
    ))}
  </ul>
)}
