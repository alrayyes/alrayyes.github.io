---
// A persistent site-wide header, present on every page via Layout.astro —
// the only way back to "/" from a subpage (privacy, disclaimer, and the
// changelog/license pages) before this existed. Kept separate from each
// page's own <h1> (index.astro's "APIs" hero, say): this is site chrome,
// not page content.
//
// The light/dark toggle lives here too, not repeated per page — same
// placement convention washy-washy-web's own ThemeToggle uses. This site
// has no JS framework (unlike washy-washy-web's Svelte), so the toggle is
// a plain <script>, not a component with reactive state — one button
// doesn't justify adding a framework dependency for it.
//
// On a subpage the header also names the page ("alrayyes/APIs / privacy",
// read off the URL so no page has to pass it in) and carries an explicit
// "← APIs" link back to the index. The home page shows neither.
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const current = Astro.url.pathname.replace(/^\/+|\/+$/g, "");
---

<header class="mb-8 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-slate-200 pb-4 dark:border-slate-700">
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <a
      href="/"
      class="text-sm font-semibold tracking-tight text-slate-900 hover:text-accent dark:text-slate-100 dark:hover:text-accent-dark"
    >
      alrayyes<span class="text-slate-400 dark:text-slate-500">/</span>APIs
    </a>
    {current && (
      <>
        <span aria-hidden="true" class="text-slate-400 dark:text-slate-500">
          /
        </span>
        <span
          aria-current="page"
          class="text-sm font-medium text-slate-600 dark:text-slate-300"
        >
          {current}
        </span>
      </>
    )}
  </div>

  <div class="flex items-center gap-3">
    {current && (
      <a
        href="/"
        class="inline-flex min-h-9 items-center gap-1 text-sm font-medium text-accent underline underline-offset-2 hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-dark-hover"
      >
        <span aria-hidden="true">←</span> Repositories
      </a>
    )}

    <button
      type="button"
      id="theme-toggle"
      class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md border border-slate-200 bg-white p-1.5 text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
    >
      {/* Both icons are always in the DOM; a data-theme-scoped CSS rule
    (below) shows exactly one — avoids a hydration flash where the wrong
    icon briefly shows before JS decides which one to render. */}
      <svg
        id="theme-toggle-sun"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        aria-hidden="true"
      >
        <path
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"
          d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.7 6.7 0 0 0 10.5 10.5Z"
        ></path>
      </svg>
      <svg
        id="theme-toggle-moon"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        aria-hidden="true"
      >
        <circle
          cx="12"
          cy="12"
          r="4.5"
          stroke="currentColor"
          stroke-width="1.8"
        ></circle>
        <path
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          d="M12 2.5v2.3M12 19.2v2.3M21.5 12h-2.3M4.8 12H2.5M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6M18.4 18.4l-1.6-1.6M7.2 7.2 5.6 5.6"
        ></path>
      </svg>
    </button>
  </div>
</header>

<style>
  /* Sun shows in light mode (invites switching to dark), moon shows in
  dark mode — same pairing washy-washy-web's ThemeToggle uses. */
  #theme-toggle-moon {
    display: none;
  }
  :global([data-theme="dark"]) #theme-toggle-sun {
    display: none;
  }
  :global([data-theme="dark"]) #theme-toggle-moon {
    display: block;
  }
</style>

<script>
  import {
    readThemePreference,
    writeThemePreference,
  } from "../lib/themePreference";

  const button = document.getElementById("theme-toggle") as HTMLButtonElement;

  function setLabel(theme: "light" | "dark") {
    button.setAttribute(
      "aria-label",
      theme === "dark" ? "Switch to light theme" : "Switch to dark theme",
    );
  }

  // The bootstrap script in Layout.astro already resolved data-theme
  // before this ran; read it back rather than re-deriving it, so this
  // stays in exact agreement with what's already painted.
  setLabel(
    (document.documentElement.dataset.theme as "light" | "dark" | undefined) ??
      "light",
  );

  button.addEventListener("click", () => {
    const current =
      document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    const next = current === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    writeThemePreference(next);
    setLabel(next);
  });

  // A change in OS-level preference only matters when there's no explicit
  // choice on record — an explicit choice always wins.
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (event) => {
      if (readThemePreference() !== null) return;
      const next = event.matches ? "dark" : "light";
      document.documentElement.dataset.theme = next;
      setLabel(next);
    });
</script>
