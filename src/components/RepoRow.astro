---
import type { DirectoryRow } from "../lib/repoDirectory";
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import BrandIcon from "./icons/BrandIcon.astro";
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import RepoBadges from "./RepoBadges.astro";

interface Props {
  row: DirectoryRow;
  nested?: boolean;
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const { row, nested = false } = Astro.props;

// Every link on a row is the same quiet text link: reports, coverage, raw files
// and the API links. min-h-8 is 32px, over WCAG 2.5.8's 24px minimum.
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const quiet =
  "inline-flex min-h-8 items-center gap-1 text-sm text-slate-600 underline underline-offset-2 hover:text-accent dark:text-slate-300 dark:hover:text-accent-dark";
---

<li
  class:list={[
    "border-b border-slate-200 [contain-intrinsic-size:auto_9rem] [content-visibility:auto] last:border-b-0 dark:border-slate-700",
    nested && "ml-4 border-l pl-4 sm:ml-6",
  ]}
>
  <div
    data-repo-row
    data-name={row.name}
    data-kind={row.kind}
    data-ci-status={row.ciStatus}
    data-license={row.license}
    class="flex flex-col gap-1 py-4"
  >
    <div class="flex items-start justify-between gap-4">
      <h3 class="flex min-w-0 flex-wrap items-center gap-2">
        <a
          href={row.repo}
          class="inline-flex min-h-8 items-center font-mono text-base font-semibold break-all text-slate-900 underline decoration-slate-300 underline-offset-4 hover:text-accent hover:decoration-accent dark:text-slate-100 dark:decoration-slate-600 dark:hover:text-accent-dark dark:hover:decoration-accent-dark"
        >
          {row.name}
        </a>
        <span class="rounded border border-slate-200 bg-slate-50 px-2 py-0.5 font-mono text-xs font-medium text-slate-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-300">
          {row.kind}
        </span>
      </h3>
      {row.ciStatus !== "unknown" && (
        <p
          data-ci-status-label
          class:list={[
            "inline-flex min-h-8 shrink-0 items-center gap-1 text-xs font-medium",
            row.ciStatus === "passing"
              ? "text-green-700 dark:text-green-400"
              : "text-red-700 dark:text-red-400",
          ]}
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-3.5"
          >
            {row.ciStatus === "passing" ? (
              <path d="M3 8.5l3.2 3L13 4.5" />
            ) : (
              <path d="M4 4l8 8M12 4l-8 8" />
            )}
          </svg>
          CI {row.ciStatus}
        </p>
      )}
    </div>
    {(row.lighthouse ||
      row.tests ||
      row.coverage ||
      row.raw.length > 0 ||
      row.spec ||
      row.docs) && (
      <ul aria-label={`Links for ${row.name}`} class="flex flex-wrap gap-x-4">
        {row.lighthouse && (
          <li>
            <a href={row.lighthouse} class={quiet}>
              <BrandIcon name="lighthouse" class="size-3.5" />
              Lighthouse<span class="sr-only"> reports for {row.name}</span>
            </a>
          </li>
        )}
        {row.tests && (
          <li>
            <a href={row.tests} class={quiet}>
              <BrandIcon name="tests" class="size-3.5" />
              Test results<span class="sr-only"> for {row.name}</span>
            </a>
          </li>
        )}
        {row.coverage && (
          <li>
            <a href={row.coverage} class={quiet}>
              <BrandIcon name="coverage" class="size-3.5" />
              Coverage<span class="sr-only"> for {row.name}</span>
            </a>
          </li>
        )}
        {row.raw.map((file) => (
          <li>
            <a href={file.href} class={`${quiet} font-mono`}>
              <BrandIcon name="file" class="size-3.5" />
              {file.label}
              <span class="sr-only">
                {" "}
                ({file.format}) for {row.name}
              </span>
            </a>
          </li>
        ))}
        {row.spec && (
          <li>
            <a href={row.spec} class={quiet}>
              <BrandIcon name="openapiinitiative" class="size-3.5" />
              OpenAPI spec<span class="sr-only"> for {row.name}</span>
            </a>
          </li>
        )}
        {row.docs && (
          <li>
            <a href={row.docs} class={quiet}>
              <BrandIcon name="docs" class="size-3.5" />
              Docs<span class="sr-only"> for {row.name}</span>
            </a>
          </li>
        )}
      </ul>
    )}
    <RepoBadges name={row.name} badges={row.badges} />
  </div>
  {row.sdks.length > 0 && (
    <ul aria-label={`SDKs for ${row.name}`}>
      {row.sdks.map((sdk) => (
        <Astro.self row={sdk} nested />
      ))}
    </ul>
  )}
</li>
