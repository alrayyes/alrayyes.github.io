---
// Real brand marks (Simple Icons, MIT-licensed: https://simpleicons.org),
// vendored as inline paths rather than a package dependency for six
// static icons. `fill="currentColor"` throughout, so every icon inherits
// its surrounding text colour and themes correctly in both light and
// dark mode with no extra work.
//
// "docs" isn't a Simple Icons brand mark -- there's no single brand for
// "API reference documentation" -- so it's a plain open-book glyph
// instead, decorative in the same way the brand marks are.
//
// The report glyphs (lighthouse, tests, coverage, file, open, braces, failed,
// warning, report) are from Google's Material Icons (Apache-2.0:
// https://fonts.google.com/icons): speed, task_alt, pie_chart, code,
// open_in_new, data_object, cancel, warning and description. The paths live in
// src/lib/icons.ts, which the report page script reads too.
//
// The icon is always aria-hidden. Where a link has no visible text of its own,
// the link carries a real accessible name instead (a visually hidden label),
// as on the report page's icon buttons.

import { ICONS, type IconName } from "../../lib/icons";

export type BrandIconName = IconName;

interface Props {
  name: BrandIconName;
  class?: string;
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const { name, class: className = "size-4" } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const path = ICONS[name];
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  class={className}
>
  <path d={path}></path>
</svg>
