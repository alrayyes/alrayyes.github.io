---
import type { Api } from "../data/apis";
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import BrandIcon, { type BrandIconName } from "./icons/BrandIcon.astro";

interface Props {
  api: Api;
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const { api } = Astro.props;

// Every SDK language here is one of these four -- see src/data/apis.ts.
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
function languageIcon(language: string): BrandIconName {
  if (language.startsWith("Node")) return "nodedotjs";
  if (language === "PHP") return "php";
  if (language === "Python") return "python";
  if (language === "Go") return "go";
  throw new Error(`no brand icon mapped for SDK language: ${language}`);
}
---

<section
  class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800"
  aria-labelledby={`${api.name}-heading`}
>
  <h2 id={`${api.name}-heading`} class="text-xl font-semibold">
    {api.name}
  </h2>
  <p class="mt-1 text-slate-600 dark:text-slate-300">{api.description}</p>

  <ul class="mt-3 flex flex-wrap gap-4 text-sm">
    {/* py-1 gives each a 24px tall hit area -- WCAG 2.5.8's minimum for a
    standalone target, confirmed via a Playwright boundingBox() check. */}
    <li>
      <a
        class="inline-flex items-center gap-1.5 py-1 font-medium text-accent underline underline-offset-2 hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-dark-hover"
        href={api.repo}
      >
        <BrandIcon name="github" />
        GitHub repo
      </a>
    </li>
    <li>
      <a
        class="inline-flex items-center gap-1.5 py-1 font-medium text-accent underline underline-offset-2 hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-dark-hover"
        href={api.spec}
      >
        <BrandIcon name="openapiinitiative" />
        OpenAPI spec
      </a>
    </li>
  </ul>

  <h3 class="mt-5 text-sm font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">
    SDKs
  </h3>
  <ul class="mt-2 grid gap-2 sm:grid-cols-2">
    {api.sdks.map((sdk) => (
      <li class="rounded-md border border-slate-200 px-3 py-2 dark:border-slate-700">
        <div class="flex items-center gap-1.5 font-medium">
          <BrandIcon name={languageIcon(sdk.language)} />
          {sdk.language}
        </div>
        <div class="mt-1 flex flex-wrap gap-3 text-sm">
          {/* py-1 on top of the 20px line-height text-sm gives these a
          24px tall hit area -- WCAG 2.5.8's minimum for a standalone
          target, confirmed via a Playwright boundingBox() check. */}
          <a
            class="inline-flex items-center gap-1 py-1 text-accent underline underline-offset-2 hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-dark-hover"
            href={sdk.repo}
          >
            <BrandIcon name="github" class="size-3.5" />
            repo
          </a>
          {sdk.docs && (
            <a
              class="inline-flex items-center gap-1 py-1 text-accent underline underline-offset-2 hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-dark-hover"
              href={sdk.docs}
            >
              <BrandIcon name="docs" class="size-3.5" />
              docs
            </a>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>
