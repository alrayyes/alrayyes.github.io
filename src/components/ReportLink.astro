---
interface Props {
  href: string;
  label: string;
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const { href, label } = Astro.props;
---

{/* No icon: the label already says what the report is, and the open-book
glyph the other card links use would say "docs" on a coverage page.
py-1 on the 20px text-sm line gives a 28px tall hit area, over WCAG
2.5.8's 24px minimum. */}
<a
  class="inline-flex items-center py-1 text-accent underline underline-offset-2 hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-dark-hover"
  href={href}
>
  {label}
</a>
