---
import type { DirectorySection } from "../lib/repoDirectory";
import { flatten } from "../lib/repoDirectory";
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import RepoRow from "./RepoRow.astro";

interface Props {
  section: DirectorySection;
}

const { section } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const total = section.rows.flatMap((row) => flatten([row])).length;
const id = `group-${section.type}-${section.title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;

// The type is always said in words; the tint and border are a second cue.
const types = {
  api: {
    label: "API and SDKs",
    card: "border-sky-300 dark:border-sky-700",
    head: "bg-sky-50 dark:bg-sky-950",
    pill: "bg-sky-100 text-sky-900 dark:bg-sky-900 dark:text-sky-100",
  },
  product: {
    label: "Product",
    card: "border-teal-300 dark:border-teal-700",
    head: "bg-teal-50 dark:bg-teal-950",
    pill: "bg-teal-100 text-teal-900 dark:bg-teal-900 dark:text-teal-100",
  },
  scaffolds: {
    label: "Scaffolds",
    card: "border-dashed border-amber-400 dark:border-amber-600",
    head: "bg-amber-50 dark:bg-amber-950",
    pill: "bg-amber-100 text-amber-900 dark:bg-amber-900 dark:text-amber-100",
  },
} as const;
const style = section.type === "other" ? undefined : types[section.type];
---

{style ? (
  <section
    data-group-section
    data-total={total}
    aria-labelledby={id}
    class:list={["mt-6 rounded-lg border first:mt-0", style.card]}
  >
    <div
      class:list={[
        "flex flex-wrap items-center gap-x-3 gap-y-1 rounded-t-lg border-b px-4 py-3",
        style.card,
        style.head,
      ]}
    >
      <h2
        id={id}
        class="font-mono text-base font-semibold text-slate-900 dark:text-slate-100"
      >
        {section.title}
      </h2>
      <span
        class:list={[
          "rounded px-2 py-0.5 font-mono text-xs font-medium",
          style.pill,
        ]}
      >
        {style.label}
      </span>
      <span
        data-group-count
        class="ml-auto font-mono text-sm text-slate-700 dark:text-slate-300"
      >
        {total} {total === 1 ? "repo" : "repos"}
      </span>
      {section.description && (
        <p class="w-full text-sm text-slate-700 dark:text-slate-300">
          {section.description}
        </p>
      )}
    </div>
    <ul class="px-4">
      {section.rows.map((row) => (
        <RepoRow row={row} />
      ))}
    </ul>
  </section>
) : (
  <section data-group-section aria-labelledby={id} class="mt-6 first:mt-0">
    <h2
      id={id}
      class="border-b border-slate-300 pb-1 font-mono text-sm font-semibold text-slate-600 dark:border-slate-600 dark:text-slate-400"
    >
      {section.title}
    </h2>
    <ul>
      {section.rows.map((row) => (
        <RepoRow row={row} />
      ))}
    </ul>
  </section>
)}
