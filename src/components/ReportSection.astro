---
import { directory, filesOf } from "../lib/repoReportPage";
import type { ReportFile, RepoSection } from "../lib/reportsIndex";
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import BrandIcon from "./icons/BrandIcon.astro";

interface Props {
  section: RepoSection;
  group: ReportFile["group"];
  // The Lighthouse and Tests pages let the script read the directory and
  // replace the links with rows; Coverage stays as links.
  live?: boolean;
}

const { section, group, live = false } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const files = filesOf(section, group);
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const dir = directory(section, group);
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const headingId = `repo-reports-${group.toLowerCase()}`;

// The report glyph each group heads its section with.
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const groupIcon = {
  Lighthouse: "lighthouse",
  Tests: "tests",
  Coverage: "coverage",
} as const;
// A link to a page opens it; a link to a data file is a raw file.
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
function fileIcon(file: ReportFile) {
  return file.format === "HTML" ? "open" : "file";
}

// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const pill =
  "inline-flex min-h-9 items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1 font-mono text-sm text-slate-800 hover:border-accent hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:hover:border-accent-dark dark:hover:bg-slate-800";
---

<section
  aria-labelledby={headingId}
  data-kind={live ? group.toLowerCase() : undefined}
  data-dir={live ? dir : undefined}
>
  <h2
    id={headingId}
    class="flex items-center gap-2 text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100"
  >
    <BrandIcon
      name={groupIcon[group]}
      class="size-5 text-accent dark:text-accent-dark"
    />
    {group}
  </h2>
  {/* What the catalogue holds: all a visitor without JavaScript sees, and
  what stays when a directory has no index page to read. */}
  <ul data-fallback class="mt-3 flex flex-wrap gap-2">
    {files.map((file) => (
      <li>
        <a href={file.href} class={pill}>
          <BrandIcon name={fileIcon(file)} />
          {file.label}
          <span class="sr-only"> for {section.name}</span>
        </a>
      </li>
    ))}
  </ul>
  {live && <ul data-rows hidden class="mt-3 flex flex-col gap-3" />}
</section>
