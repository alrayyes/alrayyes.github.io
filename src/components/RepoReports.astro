---
import type { RepoSection } from "../lib/reportsIndex";

interface Props {
  section: RepoSection;
}

const { section } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const headingId = `reports-${section.name}`;
// Tests, Coverage and Lighthouse, in that order, each only when the repo has
// files of that kind.
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const groups = (["Tests", "Coverage", "Lighthouse"] as const)
  .map((group) => ({
    group,
    files: section.files.filter((file) => file.group === group),
  }))
  .filter(({ files }) => files.length > 0);

// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const pill =
  "inline-flex min-h-8 items-center gap-1.5 rounded-md border border-slate-200 bg-white px-2 py-1 font-mono text-sm text-slate-800 hover:border-accent hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:hover:border-accent-dark dark:hover:bg-slate-800";
---

<section
  aria-labelledby={headingId}
  data-repo={section.name}
  class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800"
>
  <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-slate-200 pb-3 dark:border-slate-700">
    <h2
      id={headingId}
      class="font-mono text-lg font-semibold break-all text-slate-900 dark:text-slate-100"
    >
      <a
        href={section.repo}
        class="inline-block py-1 underline decoration-slate-300 underline-offset-4 hover:text-accent hover:decoration-accent dark:decoration-slate-600 dark:hover:text-accent-dark dark:hover:decoration-accent-dark"
      >
        {section.name}
      </a>
    </h2>
    <span class="rounded border border-slate-200 bg-slate-50 px-2 py-0.5 font-mono text-xs font-medium text-slate-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-300">
      {section.kind}
    </span>
  </div>

  <dl class="mt-4 flex flex-col gap-4">
    {groups.map(({ group, files }) => (
      <div class="flex flex-col gap-1.5 sm:flex-row sm:gap-4">
        <dt class="w-24 shrink-0 pt-1.5 font-mono text-xs font-semibold tracking-wider text-slate-600 uppercase dark:text-slate-400">
          {group}
        </dt>
        <dd>
          <ul class="flex flex-wrap gap-2">
            {files.map((file) => (
              <li>
                <a href={file.href} class={pill}>
                  {file.label}
                  <span class="rounded border border-slate-200 bg-slate-100 px-1 font-sans text-xs font-medium text-slate-700 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    {file.format}
                  </span>
                  <span class="sr-only"> for {section.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </dd>
      </div>
    ))}
  </dl>
</section>
