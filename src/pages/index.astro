---
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import RepoRow from "../components/RepoRow.astro";
import { apis } from "../data/apis";
import { otherRepos } from "../data/repos";
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import Layout from "../layouts/Layout.astro";
import {
  ANY_LICENCE,
  CI_FILTERS,
  directoryGroups,
  directoryRows,
  flatten,
  KINDS,
  licences,
} from "../lib/repoDirectory";

// This site's Lighthouse pages are its own routes, so a new page gets a link
// without anyone listing it.
const rows = directoryRows({
  pages: Object.keys(import.meta.glob("/src/pages/**/*.astro")),
  apis,
  others: otherRepos,
});
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const groups = directoryGroups(rows);
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const licenceOptions = licences(flatten(rows));
// min-h-9 is 36px, over WCAG 2.5.8's 24px minimum.
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const select =
  "mt-1 block min-h-9 rounded-md border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100";
// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const textButton =
  "inline-flex min-h-8 items-center text-sm text-slate-700 underline underline-offset-2 hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent dark:text-slate-300 dark:hover:text-accent-dark";
---

<Layout title="Repositories — alrayyes">
  <header>
    <h1 class="text-3xl font-bold">Repositories</h1>
    <p class="mt-2 max-w-prose text-slate-600 dark:text-slate-300">
      Every active public repo of mine, A to Z, with the badges from its README.
      Where a repo publishes test, coverage or Lighthouse reports, they're
      linked on its row, and the APIs and their SDKs link their OpenAPI spec and
      docs too —{" "}
      <a
        class="underline underline-offset-2"
        href="https://github.com/alrayyes"
      >
        github.com/alrayyes
      </a>
      .
    </p>
  </header>

  {/* Only shown once the script below has run, so there is no search box that
  does nothing without JavaScript. */}
  <div id="directory-filter" hidden class="mt-6">
    <label
      for="directory-filter-input"
      class="block text-sm font-medium text-slate-800 dark:text-slate-200"
    >
      Filter repositories by name
    </label>
    <input
      id="directory-filter-input"
      type="search"
      autocomplete="off"
      class="mt-1 w-full max-w-md rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
    />
    <div role="group" aria-label="Kind" class="mt-3 flex flex-wrap gap-2">
      {KINDS.map((kind) => (
        <button
          type="button"
          data-kind-filter={kind}
          aria-pressed={kind === "All" ? "true" : "false"}
          class="inline-flex min-h-8 items-center rounded-full border border-slate-300 bg-white px-3 text-sm text-slate-800 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-white dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800 dark:aria-pressed:border-accent-dark dark:aria-pressed:bg-accent-dark dark:aria-pressed:text-slate-900"
        >
          {kind}
        </button>
      ))}
    </div>
    <div class="mt-3 flex flex-wrap items-end gap-4">
      <div>
        <label
          for="directory-filter-ci"
          class="block text-sm font-medium text-slate-800 dark:text-slate-200"
        >
          CI
        </label>
        <select id="directory-filter-ci" class={select}>
          {CI_FILTERS.map((option) => (
            <option>{option}</option>
          ))}
        </select>
      </div>
      <div>
        <label
          for="directory-filter-licence"
          class="block text-sm font-medium text-slate-800 dark:text-slate-200"
        >
          Licence
        </label>
        <select id="directory-filter-licence" class={select}>
          <option>{ANY_LICENCE}</option>
          {licenceOptions.map((option) => (
            <option>{option}</option>
          ))}
        </select>
      </div>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <ul
        id="directory-active"
        aria-label="Active filters"
        hidden
        class="flex flex-wrap gap-2"
      ></ul>
      <button id="directory-clear" type="button" hidden class={textButton}>
        Clear filters
      </button>
    </div>
    <p
      id="directory-count"
      role="status"
      class="mt-2 text-sm text-slate-600 dark:text-slate-400"
    ></p>
  </div>

  <div id="directory-list" class="mt-6">
    {groups.map(({ label, rows: group }) => (
      <section
        data-letter-group
        aria-labelledby={`group-${label}`}
        class="mt-6 first:mt-0"
      >
        <h2
          id={`group-${label}`}
          class="border-b border-slate-300 pb-1 font-mono text-sm font-semibold text-slate-600 dark:border-slate-600 dark:text-slate-400"
        >
          {label}
        </h2>
        <ul>
          {group.map((row) => (
            <RepoRow row={row} />
          ))}
        </ul>
      </section>
    ))}
  </div>

  <p
    id="directory-empty"
    hidden
    class="mt-6 rounded-lg border border-dashed border-slate-300 p-4 text-sm text-slate-700 dark:border-slate-600 dark:text-slate-300"
  >
    No matching repositories. Clear the filters to see all of them.
    <button
      id="directory-empty-clear"
      type="button"
      class={`ml-2 ${textButton}`}
    >
      Clear filters
    </button>
  </p>
</Layout>

<script>
  import {
    ANY_LICENCE,
    type CiFilter,
    filterRows,
    type KindFilter,
  } from "../lib/repoDirectory";

  const wrapper = document.getElementById("directory-filter") as HTMLElement;
  const input = document.getElementById(
    "directory-filter-input",
  ) as HTMLInputElement;
  const count = document.getElementById("directory-count") as HTMLElement;
  const empty = document.getElementById("directory-empty") as HTMLElement;
  const ciSelect = document.getElementById(
    "directory-filter-ci",
  ) as HTMLSelectElement;
  const licenceSelect = document.getElementById(
    "directory-filter-licence",
  ) as HTMLSelectElement;
  const active = document.getElementById("directory-active") as HTMLElement;
  const clear = document.getElementById("directory-clear") as HTMLElement;
  const emptyClear = document.getElementById(
    "directory-empty-clear",
  ) as HTMLElement;
  const chips = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-kind-filter]"),
  ];
  const items = [
    ...document.querySelectorAll<HTMLElement>("[data-repo-row]"),
  ].map((element) => ({
    element,
    name: element.dataset.name ?? "",
    kind: element.dataset.kind ?? "",
    hasCi: element.dataset.ci === "true",
    license: element.dataset.license ?? "",
  }));
  const groups = [
    ...document.querySelectorAll<HTMLElement>("[data-letter-group]"),
  ];
  let kind: KindFilter = "All";

  // One removable chip per CI or licence filter that is set.
  function renderActive(ci: string, license: string) {
    const set = [
      { text: `CI: ${ci}`, on: ci !== "Any", reset: ciSelect, to: "Any" },
      {
        text: `Licence: ${license}`,
        on: license !== ANY_LICENCE,
        reset: licenceSelect,
        to: ANY_LICENCE,
      },
    ].filter((filter) => filter.on);
    active.replaceChildren(
      ...set.map((filter) => {
        const item = document.createElement("li");
        item.className =
          "inline-flex items-center gap-1 rounded-full border border-accent bg-white py-0.5 pr-0.5 pl-3 text-sm text-slate-900 dark:border-accent-dark dark:bg-slate-900 dark:text-slate-100";
        item.append(filter.text);
        const remove = document.createElement("button");
        remove.type = "button";
        remove.ariaLabel = `Remove filter ${filter.text}`;
        remove.className =
          "inline-flex size-8 items-center justify-center rounded-full hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent dark:hover:bg-slate-800";
        remove.textContent = "×";
        remove.addEventListener("click", () => {
          filter.reset.value = filter.to;
          update();
        });
        item.append(remove);
        return item;
      }),
    );
    active.hidden = set.length === 0;
  }

  function clearAll() {
    input.value = "";
    kind = "All";
    for (const chip of chips) {
      chip.setAttribute(
        "aria-pressed",
        String(chip.dataset.kindFilter === "All"),
      );
    }
    ciSelect.value = "Any";
    licenceSelect.value = ANY_LICENCE;
    update();
  }

  function update() {
    const ci = ciSelect.value as CiFilter;
    const license = licenceSelect.value;
    const shown = new Set(
      filterRows(items, input.value, kind, { ci, license }),
    );
    for (const item of items) item.element.hidden = !shown.has(item);
    // An API stays visible while one of its SDKs matches.
    for (const item of items) {
      const nested = item.element.parentElement?.querySelector(
        "ul [data-repo-row]:not([hidden])",
      );
      if (nested) item.element.hidden = false;
    }
    for (const item of items) {
      const holder = item.element.parentElement as HTMLElement;
      holder.hidden = !holder.querySelector("[data-repo-row]:not([hidden])");
    }
    for (const group of groups) {
      group.hidden = !group.querySelector("[data-repo-row]:not([hidden])");
    }
    renderActive(ci, license);
    clear.hidden = !(
      ci !== "Any" ||
      license !== ANY_LICENCE ||
      kind !== "All" ||
      input.value !== ""
    );
    count.textContent = `Showing ${shown.size} of ${items.length} repositories`;
    empty.hidden = shown.size !== 0;
  }

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      kind = chip.dataset.kindFilter as KindFilter;
      for (const other of chips) {
        other.setAttribute("aria-pressed", String(other === chip));
      }
      update();
    });
  }
  input.addEventListener("input", update);
  ciSelect.addEventListener("change", update);
  licenceSelect.addEventListener("change", update);
  clear.addEventListener("click", clearAll);
  emptyClear.addEventListener("click", clearAll);
  wrapper.hidden = false;
  update();
</script>
