---
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import Layout from "../layouts/Layout.astro";
---

<Layout title="Privacy — APIs">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    Privacy
  </h1>

  <section
    aria-labelledby="glance-heading"
    class="mt-6 rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800"
  >
    <h2
      id="glance-heading"
      class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100"
    >
      At a glance
    </h2>
    <ul class="mt-3 grid gap-2 text-sm font-medium text-slate-800 sm:grid-cols-2 dark:text-slate-100">
      {[
        "No cookies",
        "No tracking scripts",
        "No third-party requests",
        "Theme choice stored locally",
      ].map((claim) => (
        <li class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-900">
          {claim}
        </li>
      ))}
    </ul>
  </section>

  <div class="mt-8 flex flex-col gap-8 text-slate-700 dark:text-slate-300">
    <section aria-labelledby="built-heading">
      <h2
        id="built-heading"
        class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100"
      >
        How the site is built
      </h2>
      <p class="mt-2">
        This site is fully static. There's no server-side application code of
        any kind in this repository's build output, no database, and no
        analytics or tracking script of any kind.
      </p>
    </section>

    <section aria-labelledby="fonts-heading">
      <h2
        id="fonts-heading"
        class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100"
      >
        Fonts and third parties
      </h2>
      <p class="mt-2">
        Its own font is self-hosted (bundled at build time, not loaded from a
        font CDN), so loading this page makes no request to any third party at
        all.
      </p>
    </section>

    <section aria-labelledby="links-heading">
      <h2
        id="links-heading"
        class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100"
      >
        Links to other sites
      </h2>
      <p class="mt-2">
        Only clicking a link on this site sends your browser to that link's own
        destination (a GitHub repo, an SDK's docs site, or pkg.go.dev), each
        governed by that destination's own privacy policy, not this one.
      </p>
    </section>

    <section aria-labelledby="storage-heading">
      <h2
        id="storage-heading"
        class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100"
      >
        What's stored in your browser
      </h2>
      <p class="mt-2">
        This site sets no cookies. The one thing it stores is your light or dark
        theme choice, in your browser's localStorage, and only after you use the
        theme toggle. It never leaves your device, and clearing your site data
        removes it.
      </p>
    </section>
  </div>
</Layout>
