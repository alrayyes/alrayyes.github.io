---
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found — APIs">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    Page not found
  </h1>
  <p class="mt-4 text-slate-700 dark:text-slate-300">
    Nothing lives at this address. The link may be old, or the repo's reports
    may have moved.
  </p>
  <ul class="mt-6 flex flex-col gap-2">
    <li>
      <a
        href="/"
        class="inline-block py-1 text-blue-800 underline underline-offset-2 hover:text-blue-950 dark:text-blue-300 dark:hover:text-blue-200"
      >
        Back to the directory
      </a>
    </li>
    <li>
      <a
        href="/reports/"
        class="inline-block py-1 text-blue-800 underline underline-offset-2 hover:text-blue-950 dark:text-blue-300 dark:hover:text-blue-200"
      >
        Browse the reports
      </a>
    </li>
  </ul>
</Layout>
