---
// Renders this repo's own LICENSE file in full, styled with the site's
// chrome, instead of sending visitors to the raw file on GitHub -- same
// idea as changelog.astro, adapted for plain text rather than Markdown
// (GPL-3.0's own LICENSE file has no markdown structure to render).
// `?raw` (Vite) reads the file's text at build time with no npm content
// collection needed for a single plain-text file.
import licenseText from "../../LICENSE?raw";
// biome-ignore lint/correctness/noUnusedImports: used in the template below the frontmatter fence, which Biome does not parse for .astro files
import Layout from "../layouts/Layout.astro";
import { licenseSections } from "../lib/licenseSections";
import { licenseSummary } from "../lib/licenseSummary";

// biome-ignore lint/correctness/noUnusedVariables: used in the template below the frontmatter fence, which Biome does not parse for .astro files
const sections = licenseSections(licenseText);
---

<Layout title="License — APIs">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
    License
  </h1>
  <p class="mt-2 text-slate-600 dark:text-slate-300">
    GPL-3.0-or-later, in full, below.
  </p>
  <section
    aria-labelledby="license-summary-heading"
    class="mt-6 rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800"
  >
    <h2
      id="license-summary-heading"
      class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100"
    >
      Summary
    </h2>
    <div class="mt-3 grid gap-4 sm:grid-cols-3">
      {licenseSummary.map((group) => (
        <div>
          <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">
            {group.title}
          </h3>
          <ul class="mt-1 list-inside list-disc text-sm text-slate-600 dark:text-slate-300">
            {group.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">
      This is a summary, not legal advice. The full text below is what applies.
      Summary from
      <a
        href="https://www.tldrlegal.com/license/gnu-general-public-license-v3-gpl-3"
        class="text-accent underline underline-offset-2 hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-dark-hover"
      >
        TLDRLegal
      </a>
      .
    </p>
  </section>
  <nav
    aria-label="Table of contents"
    class="mt-6 rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800"
  >
    <ul class="grid gap-x-6 text-sm sm:grid-cols-2">
      {sections.map((section) => (
        <li>
          <a
            href={`#${section.id}`}
            class="inline-flex min-h-6 items-center py-0.5 text-accent underline underline-offset-2 hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-dark-hover"
          >
            {section.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {sections.map((section) => (
    <section
      id={section.id}
      class="mt-8 scroll-mt-6"
      aria-labelledby={`${section.id}-heading`}
    >
      <h2
        id={`${section.id}-heading`}
        class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100"
      >
        {section.title}
      </h2>
      <!-- prettier-ignore -->
      <pre class="mt-3 max-w-full overflow-x-auto rounded-lg border border-slate-200 bg-slate-50 p-4 text-xs leading-relaxed whitespace-pre-wrap text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">{section.body}</pre>
    </section>
  ))}
</Layout>
