{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apis.ryankes.eu/schema/repos.schema.json",
  "title": "Other repos that publish reports",
  "description": "Repos that publish test, coverage or Lighthouse reports but aren't APIs, so they have no card in the catalogue. Listed on the Reports page.",
  "type": "object",
  "required": ["groups", "repos"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "groups": {
      "description": "The groups repos can join. The Repositories page shows each as a card or section, in this order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repo"
      }
    }
  },
  "$defs": {
    "repo": {
      "type": "object",
      "required": ["name", "kind", "repo", "reports", "license", "badges"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "The repo's name, as it appears in its URL.",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "description": "What sort of repo it is, shown beside its name.",
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "reports": {
          "$ref": "apis.schema.json#/$defs/reports"
        },
        "license": {
          "$ref": "apis.schema.json#/$defs/license"
        },
        "badges": {
          "$ref": "apis.schema.json#/$defs/badges"
        },
        "group": {
          "description": "The id of the group the repo belongs to. Leave it out for a repo in no group.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "title", "type"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "What a repo's `group` names.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "description": "The heading shown for the group.",
          "type": "string",
          "minLength": 1
        },
        "type": {
          "description": "`product` is a card for related repos; `scaffolds` is a section of starter templates; `api` adds repos to the card of the API in apis.json that names the group.",
          "enum": ["product", "scaffolds", "api"]
        },
        "description": {
          "description": "One line under the heading.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
