{
  "$schema": "./apis.schema.json",
  "apis": [
    {
      "name": "hush-hush",
      "description": "Self-hosted secrets object store: age-sealed ciphertext, no plaintext ever stored or returned.",
      "repo": "https://github.com/alrayyes/Hush-Hush",
      "spec": "https://github.com/alrayyes/Hush-Hush/blob/main/api/openapi.yaml",
      "docs": "https://apis.ryankes.eu/Hush-Hush/docs/api/#description/introduction",
      "reports": {
        "tests": "https://apis.ryankes.eu/Hush-Hush/reports/tests/junit.xml",
        "coverage": "https://apis.ryankes.eu/Hush-Hush/reports/coverage/",
        "coverageXml": "https://apis.ryankes.eu/Hush-Hush/reports/coverage/coverage.xml"
      },
      "sdks": [
        {
          "language": "PHP",
          "repo": "https://github.com/alrayyes/hush-hush-php",
          "docs": "https://alrayyes.github.io/hush-hush-php/",
          "reports": {
            "tests": "https://apis.ryankes.eu/hush-hush-php/reports/tests/junit.xml",
            "coverage": "https://apis.ryankes.eu/hush-hush-php/reports/coverage/",
            "coverageXml": "https://apis.ryankes.eu/hush-hush-php/reports/coverage/coverage.xml"
          }
        },
        {
          "language": "Node.js / TypeScript",
          "repo": "https://github.com/alrayyes/hush-hush-node",
          "docs": "https://alrayyes.github.io/hush-hush-node/"
        },
        {
          "language": "Python",
          "repo": "https://github.com/alrayyes/hush-hush-python",
          "docs": "https://alrayyes.github.io/hush-hush-python/",
          "reports": {
            "tests": "https://apis.ryankes.eu/hush-hush-python/reports/tests/junit.xml",
            "coverage": "https://apis.ryankes.eu/hush-hush-python/reports/coverage/",
            "coverageXml": "https://apis.ryankes.eu/hush-hush-python/reports/coverage/coverage.xml"
          }
        },
        {
          "language": "Go",
          "repo": "https://github.com/alrayyes/hush-hush-go",
          "docs": "https://pkg.go.dev/github.com/alrayyes/hush-hush-go"
        }
      ]
    },
    {
