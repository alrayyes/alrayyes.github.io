{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apis.ryankes.eu/schema/apis.schema.json",
  "title": "API catalogue",
  "description": "The public HTTP APIs listed on apis.ryankes.eu, each with its OpenAPI spec and generated SDKs.",
  "type": "object",
  "required": ["apis"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apis": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/api"
      }
    }
  },
  "$defs": {
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "reports": {
      "description": "Links to the reports the repo publishes at apis.ryankes.eu/<repo>/reports/. Only set a key once its URL has been checked to resolve.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lighthouse": {
          "$ref": "#/$defs/url"
        },
        "tests": {
          "$ref": "#/$defs/url"
        },
        "coverage": {
          "$ref": "#/$defs/url"
        },
        "coverageXml": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "sdk": {
      "type": "object",
      "required": ["language", "repo", "license", "badges"],
      "additionalProperties": false,
      "properties": {
        "language": {
          "description": "Display name; the card picks its icon from this.",
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "$ref": "#/$defs/url"
        },
        "docs": {
          "description": "Only set once the URL has been checked to resolve.",
          "$ref": "#/$defs/url"
        },
        "reports": {
          "$ref": "#/$defs/reports"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "badges": {
          "$ref": "#/$defs/badges"
        }
      }
    },
    "api": {
      "type": "object",
      "required": ["name", "description", "repo", "spec", "sdks", "license", "badges"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "$ref": "#/$defs/url"
        },
        "spec": {
          "$ref": "#/$defs/url"
        },
        "docs": {
          "description": "Only set once the URL has been checked to resolve.",
          "$ref": "#/$defs/url"
        },
        "sdks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sdk"
          }
        },
        "reports": {
          "$ref": "#/$defs/reports"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "badges": {
          "$ref": "#/$defs/badges"
        },
        "group": {
          "description": "The id of an `api` group declared in repos.json. Repos that name the same group share this API's card on the front page.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "badge": {
      "description": "A badge from the repo's README: the image it shows and where it links. The kind is what the page filters and orders by; the label is the badge's alt text.",
      "type": "object",
      "required": ["kind", "label", "image", "href"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "What the badge reports. `ci` is any GitHub Actions workflow badge; `other` covers package, docs and scorecard badges.",
          "enum": ["ci", "coverage", "release", "license", "deployment", "other"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "$ref": "#/$defs/url"
        },
        "href": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "badges": {
      "description": "The badges at the top of the repo's README, in README order. Empty when the README has none.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/badge"
      }
    },
    "license": {
      "description": "The repo's licence as an SPDX id, or `Unlicensed`. The licence filter lists these.",
      "type": "string",
      "minLength": 1
    }
  }
}
