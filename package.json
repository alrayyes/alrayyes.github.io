{
  "name": "alrayyes.github.io",
  "version": "0.49.0",
  "private": true,
  "description": "A catalogue of the public HTTP APIs I maintain, and every SDK generated for each.",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro check",
    "dev": "astro dev",
    "format": "biome check --write .",
    "format:check": "prettier --check \"**/*.{md,yml,yaml,astro}\"",
    "lighthouse": "./scripts/lighthouse.sh",
    "lint": "biome check .",
    "lint:md": "markdownlint-cli2",
    "lint:mechanics": "./scripts/lint-mechanics.sh",
    "lint:prose": "./scripts/lint-prose.sh",
    "lint:tailwind": "oxlint",
    "prepare": "lefthook install || true",
    "preview": "astro preview",
    "sort-package-json": "sort-package-json",
    "sort-package-json:check": "sort-package-json --check",
    "storybook": "bun scripts/render-stories.ts && storybook dev -p 6006",
    "storybook:render": "bun scripts/render-stories.ts",
    "storybook:screenshots": "bun scripts/storybook-screenshots.ts",
    "test": "bun run test:unit && bun run test:e2e",
    "test:coverage": "bun run test:unit --coverage --coverage-reporter=lcov",
    "test:e2e": "playwright test",
    "test:storybook": "bun test ./scripts/storybook-smoke.ts",
    "test:unit": "bun test src scripts"
  },
  "overrides": {
    "@emnapi/runtime": "1.11.3",
    "http-cache-semantics": "4.3.0",
    "katex": "0.19.0",
    "re2js": "2.8.7",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2"
  },
  "dependencies": {
    "@codecov/astro-plugin": "2.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.8",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.0",
    "@shadcn/lint": "0.2.5",
    "@storybook/html-vite": "10.6.7",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bun-types": "1.4.4",
    "lefthook": "2.2.2",
    "lighthouse": "13.6.0",
    "linkedom": "0.18.15",
    "markdownlint-cli2": "0.24.0",
    "oxlint": "1.93.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sort-package-json": "4.1.0",
    "storybook": "10.6.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "esbuild",
    "lefthook"
  ]
}
