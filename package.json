{
  "name": "alrayyes.github.io",
  "version": "0.40.0",
  "private": true,
  "description": "A catalogue of the public HTTP APIs I maintain, and every SDK generated for each.",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro check",
    "dev": "astro dev",
    "format": "biome check --write .",
    "format:check": "prettier --check \"**/*.{md,yml,yaml,astro}\"",
    "lighthouse": "./scripts/lighthouse.sh",
    "lint": "biome check .",
    "lint:md": "markdownlint-cli2",
    "lint:mechanics": "./scripts/lint-mechanics.sh",
    "lint:prose": "./scripts/lint-prose.sh",
    "lint:tailwind": "oxlint",
    "prepare": "lefthook install || true",
    "preview": "astro preview",
    "sort-package-json": "sort-package-json",
    "sort-package-json:check": "sort-package-json --check",
    "test": "bun run test:unit && bun run test:e2e",
    "test:coverage": "bun run test:unit --coverage --coverage-reporter=lcov",
    "test:e2e": "playwright test",
    "test:unit": "bun test src scripts"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "katex": "0.19.0",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2"
  },
  "dependencies": {
    "@codecov/astro-plugin": "2.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.63.0",
    "@shadcn/lint": "0.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bun-types": "1.4.2",
    "lefthook": "2.1.16",
    "lighthouse": "13.5.0",
    "markdownlint-cli2": "0.23.3",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sort-package-json": "4.0.0",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "esbuild",
    "lefthook"
  ]
}
